[Unit]
Description=Melexis thermal sensor dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thermal
SupplementaryGroups=dialout
WorkingDirectory=/opt/thermal-sensor
ExecStart=/opt/thermal-sensor/.venv/bin/python /opt/thermal-sensor/thermal_web.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
